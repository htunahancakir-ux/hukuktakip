{
  "name": "hanhukuk",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local outputs/icrapro/server.cjs",
    "build": "node scripts/build.cjs",
    "format:check": "prettier --check \"outputs/icrapro/{access-*.cjs,workspace-*.js,auth.js,login-recovery.js,app.js,dashboard.js,client-records.js,document-records.js,document-types.js,form-inputs.js,borrower-sheet.js,finance-operations.js,settings.js,personnel.js,index.html,workspace-layout.css}\"",
    "test": "node tests/run.cjs && node --test tests/postgres.test.cjs tests/backups.test.cjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/database.cjs migrate",
    "db:import": "node --env-file-if-exists=.env.local scripts/database.cjs import",
    "db:verify": "node --env-file-if-exists=.env.local scripts/database.cjs verify",
    "backup:restore": "node --env-file-if-exists=.env.local scripts/restore-backup.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@vercel/functions": "3.11.0",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "prettier": "3.9.10"
  }
}
